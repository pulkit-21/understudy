# Backend dev image — live-reload uvicorn on the Playwright base (Chromium +
# system deps preinstalled). Source is bind-mounted by docker-compose, so code
# edits reload without a rebuild.
FROM mcr.microsoft.com/playwright/python:v1.48.0-noble
WORKDIR /app

# Dependencies are baked into the image; only they invalidate the layer cache.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt \
    && playwright install chromium

# app/ is bind-mounted at runtime; PYTHONPATH points uvicorn at it.
ENV PYTHONPATH=/app/backend \
    UNDERSTUDY_DATA=/data \
    PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "export UNDERSTUDY_BASE_URL=http://127.0.0.1:${PORT} && exec uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT} --reload --reload-dir backend"]
