# Understudy configuration. Copy to `.env` (git-ignored) and fill in.
# Every value has a safe local-dev default — you only need ANTHROPIC_API_KEY to
# unlock the LLM legibility pass and the full conversational agent. All other
# knobs are optional. See backend/app/config.py for the authoritative list.

# --- models --------------------------------------------------------------
# Enables the LLM workflow-legibility pass + the full conversational agent.
# Unset -> both fall back to deterministic/keyless behavior (the demo still runs).
ANTHROPIC_API_KEY=

# Conversational agent (high-frequency tool-use loop) — Sonnet is fast + cheap.
UNDERSTUDY_AGENT_MODEL=claude-sonnet-5
# One-shot workflow legibility pass — Opus for the extra capability.
UNDERSTUDY_INDUCTION_MODEL=claude-opus-4-8

# --- storage -------------------------------------------------------------
# UNDERSTUDY_DATA=./data
# DATABASE_URL=postgresql://user:pass@host/db   # unset -> SQLite under UNDERSTUDY_DATA

# --- web / runner --------------------------------------------------------
# UNDERSTUDY_BASE_URL=http://localhost:8000
# UNDERSTUDY_HEADFUL=0            # 1 -> run Chromium with a visible window

# --- auth / toggles ------------------------------------------------------
# UNDERSTUDY_JWT_SECRET=change-me-in-prod-at-least-32-bytes-long
# UNDERSTUDY_DEV_MODE=1           # required to boot with the committed dev JWT
#                                 # secret; a real deploy leaves this unset and
#                                 # MUST set UNDERSTUDY_JWT_SECRET (fail-closed).
# UNDERSTUDY_ENABLE_TEST_HOOKS=0  # 1 -> expose POST /erp/_reset (dev/eval only)
# UNDERSTUDY_RATELIMIT=1          # 0 -> disable request rate limiting
# UNDERSTUDY_AGENT_MOCK=0         # 1 -> force the keyless deterministic agent
